# Copie este arquivo para .env e preencha com os dados do seu projeto Supabase
# (Project Settings > API). Nunca envie o .env real para o repositório.

# URL do projeto Supabase
SUPABASE_URL=https://seu-projeto.supabase.co

# Secret key (service role) — usada apenas no back-end
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Porta HTTP da API (opcional, padrão 3000)
PORT=3000

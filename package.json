{
  "name": "pet_clinic_api",
  "version": "2.0.0",
  "description": "API REST de gerenciamento de tutores, pets e consultas de uma clínica veterinária (Avaliação Final - Desenvolvimento Back-End)",
  "keywords": [
    "back-end",
    "ts",
    "API",
    "veterinary",
    "pets",
    "node"
  ],
  "license": "ISC",
  "author": "Lucas Vaz da Silva, Kaue Favoretto, Waldir Gutierrez",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --import=tsx/esm src/server.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^5.1.2",
    "supertest": "^7.3.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "express": "^5.2.1",
    "swagger-ui-express": "^5.0.1"
  }
}
